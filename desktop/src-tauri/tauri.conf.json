{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YuChao",
  "version": "1.2.0",
  "identifier": "cloud.neoix.yuchao",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "驭潮 YuChao",
        "url": "https://www.neoix.cloud/",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#0A0A0B",
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "category": "Finance",
    "shortDescription": "驭潮 A 股看盘工作台",
    "longDescription": "驭潮 YuChao：A 股看盘工作台桌面版（K线、指标、自选、板块全景）"
  }
}
